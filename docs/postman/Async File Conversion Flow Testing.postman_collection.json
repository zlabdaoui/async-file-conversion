    {
      "name": "Poll File Conversion Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const schema = {\r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"id\": {\r",
              "      \"type\": \"string\",\r",
              "      \"pattern\": \"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$\"\r",
              "    },\r",
              "    \"original_filename\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"stored_filename\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"original_format\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"target_format\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"status\": {\r",
              "      \"type\": \"string\",\r",
              "      \"enum\": [\"PENDING\", \"PROCESSING\", \"COMPLETED\", \"FAILED\"]\r",
              "    },\r",
              "    \"created_at\": {\r",
              "      \"type\": \"string\",\r",
              "      \"format\": \"date-time\"\r",
              "    },\r",
              "    \"completed_at\": {\r",
              "      \"type\": [\"string\", \"null\"]\r",
              "    },\r",
              "    \"result_filename\": {\r",
              "      \"type\": [\"string\", \"null\"]\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\"id\", \"original_filename\", \"stored_filename\", \"original_format\", \"target_format\", \"status\", \"created_at\", \"completed_at\", \"result_filename\"]\r",
              "};\r",
              "\r",
              "const Ajv = require('ajv');\r",
              "const ajv = new Ajv(); \r",
              "\r",
              "let response = pm.response.json();\r",
              "\r",
              "let validate = ajv.compile(schema);\r",
              "let valid = validate(response);\r",
              "\r",
              "\r",
              "pm.test(\"Response matches JSON schema\", function () {\r",
              "    pm.expect(valid).to.be.true;\r",
              "});\r",
              "\r",
              "const poll_max_retries = pm.environment.get('poll_max_retries') || 5;\r",
              "let poll_retry_count = pm.environment.get('poll_retry_count') || 0;\r",
              "\r",
              "if (response.status !== \"COMPLETED\" && poll_retry_count < poll_max_retries) {\r",
              "    poll_retry_count++;\r",
              "    pm.environment.set('poll_retry_count', poll_retry_count);\r",
              "    pm.execution.setNextRequest(\"Poll File Conversion Status\");\r",
              "} else {\r",
              "    pm.environment.set('poll_retry_count', 0); \r",
              "    pm.test(\"File Conversion Status is 'COMPLETED'\", function () {\r",
              "        pm.expect(response.status).to.eql(\"COMPLETED\");\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
